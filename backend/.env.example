NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-POOLER-HOST/neondb?sslmode=require&connect_timeout=30&pool_timeout=30&connection_limit=5"
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-DIRECT-HOST/neondb?sslmode=require&connect_timeout=30"
SESSION_SECRET=REPLACE_WITH_RANDOM_64_CHARACTER_SECRET
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
TRUST_PROXY=false
# Number of trusted reverse proxy hops; applies only when TRUST_PROXY=true.
TRUST_PROXY_HOPS=1
# Optional shared server secret (32+ random characters), also set on Vercel.
# Preserves individual visitor limits through the frontend directory API proxy.
API_PROXY_SECRET=
# Shared request limits. API: per IP/minute; others: per 15 minutes.
RATE_LIMIT_API=300
RATE_LIMIT_AUTH=20
RATE_LIMIT_WRITE=30
RATE_LIMIT_UPLOAD=6
BOOTSTRAP_ADMIN_EMAILS=
# Optional: paste a fine-grained GitHub token here to avoid local API rate limits.
# This backend only reads public repositories; no write permissions are needed.
GITHUB_TOKEN=
# Use BANNER_STORAGE=disabled to keep the API running while banner uploads are unavailable.
# Production local-disk uploads are blocked unless the temporary preview opt-in is enabled.
BANNER_STORAGE=local
# Preview only: allow local banner files without S3. Files may disappear on restart/redeploy.
ALLOW_EPHEMERAL_BANNER_STORAGE=false

# Redis shared public profile cache; leave empty to read directly from PostgreSQL.
# Use Render's internal Key Value URL in the same region, or a rediss:// TLS URL.
REDIS_URL=
REDIS_KEY_PREFIX=webring:v1
# Optional comma-separated read replica pooled URLs from the SAME database/branch.
# Leave empty until real replicas have been provisioned. Never put primary here.
DATABASE_READ_URLS=
