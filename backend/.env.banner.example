# Copy these values into backend/.env; this file is an example only.
PUBLIC_API_URL=http://localhost:4000
# Local development only. Production requires s3.
BANNER_STORAGE=local
# For production R2/S3-compatible storage:
# BANNER_STORAGE=s3
S3_REGION=auto
S3_ENDPOINT=https://YOUR-ACCOUNT.r2.cloudflarestorage.com
S3_BUCKET=YOUR-BUCKET
S3_PUBLIC_URL=https://YOUR-PUBLIC-BANNER-DOMAIN
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=YOUR-ACCESS-KEY
AWS_SECRET_ACCESS_KEY=YOUR-SECRET-KEY
